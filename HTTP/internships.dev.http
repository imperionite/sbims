###############################################################

# NOT FOUND

###############################################################

### Non-existent Internship

GET {{apiUrl}}/internships/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{adminAccessToken}}

###

### Expected:

### HTTP 404

### Internship not found.

###############################################################

### Update Status of Non-existent Internship

PATCH {{apiUrl}}/internships/00000000-0000-0000-0000-000000000000/status
Authorization: Bearer {{adminAccessToken}}
Content-Type: application/json

{
"status": "active"
}

###

### Expected:

### HTTP 404

### Internship not found.

###############################################################

# AUTHENTICATION

###############################################################

### Unauthenticated - List Internships

GET {{apiUrl}}/internships

###

### Expected:

### HTTP 401

### Missing authorization token.

###############################################################

### Invalid Token - List Internships

GET {{apiUrl}}/internships
Authorization: Bearer invalid-token

###

### Expected:

### HTTP 401

### Invalid authentication token.

###############################################################

# AUTHORIZATION

###############################################################

### Student Cannot List All Internships

GET {{apiUrl}}/internships
Authorization: Bearer {{studentAccessToken}}

###

### Expected:

### HTTP 403

### Insufficient permissions.

###############################################################

### Faculty Adviser Cannot List All Internships

GET {{apiUrl}}/internships
Authorization: Bearer {{facultyAccessToken}}

###

### Expected:

### HTTP 403

### Insufficient permissions.

