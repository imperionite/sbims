###############################################################

# INTERNSHIP LIST

###############################################################

### FR-05 - Administrator List Internships

GET {{apiUrl}}/internships
Authorization: Bearer {{adminAccessToken}}

###

### Expected:

### HTTP 200

### success = true

### data = array

###############################################################

### FR-05 - Internship Coordinator List Internships
GET {{apiUrl}}/internships
Authorization: Bearer {{coordinatorAccessToken}}

###

### Expected:

### HTTP 200

### success = true

### data = array

###############################################################

# INTERNSHIP CREATE

###############################################################

### FR-05 - Administrator Create Internship Assignment

POST {{apiUrl}}/internships
Authorization: Bearer {{adminAccessToken}}
Content-Type: application/json

{
"studentId": "{{studentId}}",
"hteId": "{{hteId}}",
"requiredHours": 300,
"startDate": "2026-10-05",
"endDate": "2026-12-30",
"facultyAdviserId": "{{facultyAdviserId}}"
}

###

### Expected:

### HTTP 201

### success = true

### data.id exists

### data.student_id = {{studentId}}

### data.hte_id = {{hteId}}

### data.status = "pending"

###

### Copy the returned data.id and assign it to:

### @internshipId

###############################################################

### FR-05 - Internship Coordinator Create Internship Assignment

POST {{apiUrl}}/internships
Authorization: Bearer {{coordinatorAccessToken}}
Content-Type: application/json

{
"studentId": "{{studentId}}",
"hteId": "{{hteId}}",
"requiredHours": 300,
"startDate": "2026-06-05",
"endDate": "2026-07-30",
"facultyAdviserId": "{{facultyAdviserId}}"
}

###

### Expected:

### HTTP 409

###

### The student already has an internship assignment.

###

### This test confirms the one-internship-per-student rule.

###############################################################

# INTERNSHIP RETRIEVE

###############################################################

### FR-05 - Administrator Retrieve Internship

GET {{apiUrl}}/internships/{{internshipId}}
Authorization: Bearer {{adminAccessToken}}

### FR-05 - Coordinator Retrieve Internship

GET {{apiUrl}}/internships/{{internshipId}}
Authorization: Bearer {{coordinatorAccessToken}}

###

### Expected:

### HTTP 200

### success = true

### data.id = {{internshipId}}

### data.student_id = {{studentId}}

### data.hte_id = {{hteId}}

### data.status = "pending"

###############################################################

# STUDENT OWN INTERNSHIP

###############################################################

### FR-05 - Student Retrieve Own Internship

GET {{apiUrl}}/internships/me
Authorization: Bearer {{studentAccessToken}}

###

### Expected:

### HTTP 200

### success = true

### data.id = {{internshipId}}

### data.student_id = the authenticated student's ID

### data.hte_id = {{hteId}}

### data.status = "pending"

###############################################################

# STATUS - PENDING TO ACTIVE

###############################################################

### FR-05 - Internship Coordinator Activate Internship

PATCH {{apiUrl}}/internships/{{internshipId}}/status
Authorization: Bearer {{coordinatorAccessToken}}
Content-Type: application/json

{
"status": "active"
}

### FR-05 - Administrator Activate Internship

PATCH {{apiUrl}}/internships/{{internshipId}}/status
Authorization: Bearer {{adminAccessToken}}
Content-Type: application/json

{
"status": "active"
}

###

### Expected:

### HTTP 200

### success = true

### data.id = {{internshipId}}

### data.status = "active"

###############################################################

# STATUS - ACTIVE TO COMPLETED

###############################################################

### FR-05 - Administrator Complete Internship

PATCH {{apiUrl}}/internships/{{internshipId}}/status
Authorization: Bearer {{adminAccessToken}}
Content-Type: application/json

{
"status": "completed"
}

### FR-05 - Coordinator Complete Internship

PATCH {{apiUrl}}/internships/{{internshipId}}/status
Authorization: Bearer {{coordinatorAccessToken}}
Content-Type: application/json

{
"status": "completed"
}

###

### Expected:

### HTTP 200

### success = true

### data.id = {{internshipId}}

### data.status = "completed"

###############################################################

# STATUS - COMPLETED CANNOT TRANSITION

###############################################################

### FR-05 - Completed Internship Cannot Transition Again

PATCH {{apiUrl}}/internships/{{internshipId}}/status
Authorization: Bearer {{coordinatorAccessToken}}
Content-Type: application/json

{
"status": "active"
}

###

### Expected:

### HTTP 400

###

### Invalid internship status transition.

### Completed internships cannot transition to another status.

###############################################################

# DUPLICATE ASSIGNMENT

###############################################################

### FR-05 - Duplicate Internship Assignment

POST {{apiUrl}}/internships
Authorization: Bearer {{adminAccessToken}}
Content-Type: application/json

{
"studentId": "{{studentId}}",
"hteId": "{{hteId}}"
}

###

### Expected:

### HTTP 409

###

### The student already has an internship assignment.

