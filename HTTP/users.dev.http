###############################################################

# LOGIN ADMINISTRATOR

###############################################################

### Login Administrator

### Expected:
### - HTTP 200
### - role = administrator

POST {{apiUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{admin}}",
  "password": "{{defaultPassword}}"
}

####
POST {{apiUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{coordinator}}",
  "password": "{{defaultPassword}}"
}

###
POST {{apiUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{faculty}}",
  "password": "{{defaultPassword}}"
}

###
POST {{apiUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{student}}",
  "password": "{{newPassword}}"
}




###############################################################

# FR-02 LIST USERS

###############################################################

### List Users

### Expected:
### - HTTP 200
### - Returns user list

GET {{apiUrl}}/users
Authorization: Bearer {{adminToken}}



###############################################################

# FR-02 VIEW USER

###############################################################

### View Single User

### Replace USER_ID with existing user UUID

### Expected:
### - HTTP 200
### - Returns profile information

GET {{apiUrl}}/users/{{userId}}
Authorization: Bearer {{coordinatorToken}}

###############################################################

# Fetch Users by Role (Administrator & Coordinator)
# 

###############################################################

GET {{apiUrl}}/users/role/student
Authorization: Bearer {{coordinatorToken}}
Content-Type: application/json

###############################################################

GET {{apiUrl}}/users/role/student
Authorization: Bearer {{coordinatorToken}}
Content-Type: application/json


###############################################################

# FR-02 CREATE USER

###############################################################

### Create New Student Account

### Expected:
### - HTTP 201
### - User created in Supabase Auth
### - Profile created
### - must_change_password = true

POST {{apiUrl}}/users
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "email": "studentsbims17@grr.la",
  "firstName": "Lionel",
  "middleName": "Victor",
  "lastName": "Messi",
  "suffix": "III",
  "role": "student",
  "password": "Dev2026!"
}



###############################################################

# FR-02 UPDATE USER PROFILE

###############################################################

### Update User Information

### Expected:
### - HTTP 200
### - Profile fields updated

PATCH {{apiUrl}}/users/{{userId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "firstName": "Juan Miguel",
  "middleName": "Dela",
  "lastName": "Cruz Updated",
  "suffix": null
}



###############################################################

# VERIFY PROFILE UPDATE

###############################################################

### Expected:
### - HTTP 200
### - Updated values returned

GET {{apiUrl}}/users/{{userId}}
Authorization: Bearer {{coordinatorToken}}



###############################################################

# FR-02 CHANGE USER ROLE

###############################################################

### Change Student Role

### Example:
### student -> faculty_adviser

### Expected:
### - HTTP 200
### - Role updated

PATCH {{apiUrl}}/users/{{userId}}/role
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "role": "student"
}



###############################################################

# VERIFY ROLE CHANGE

###############################################################

### Expected:
### - role = faculty_adviser

GET {{apiUrl}}/users/{{userId}}
Authorization: Bearer {{adminToken}}



###############################################################

# FR-02 DISABLE USER

###############################################################

### Disable User

### Expected:
### - HTTP 200
### - is_active = false

PATCH {{apiUrl}}/users/{{userId}}/status
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "isActive": false
}



###############################################################

# VERIFY DISABLED USER

###############################################################

GET {{apiUrl}}/users/{{userId}}
Authorization: Bearer {{adminToken}}



###############################################################

# FR-02 ENABLE USER

###############################################################

### Enable User

### Expected:
### - HTTP 200
### - is_active = true

PATCH {{apiUrl}}/users/{{userId}}/status
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "isActive": true
}



###############################################################

# AUTHORIZATION TESTS

###############################################################



######################### Internship Coordinator #############################

###############################################################

# Coordinator Can Access User List

###############################################################

### Expected:
### HTTP 200

GET {{apiUrl}}/users
Authorization: Bearer {{coordinatorToken}}



###############################################################

# Coordinator Cannot Access Single User

###############################################################

### Expected:
### HTTP 403 Forbidden

GET {{apiUrl}}/users/{{userId}}
Authorization: Bearer {{coordinatorToken}}


###############################################################

# Coordinator Cannot Access Users by Role

###############################################################

### Expected:
### HTTP 403 Forbidden

GET {{apiUrl}}/users/role/faculty_adviser
Authorization: Bearer {{coordinatorToken}}

###############################################################

# Coordinator Cannot Create User

###############################################################

### Expected:
### HTTP 403 Forbidden

POST {{apiUrl}}/users
Authorization: Bearer {{coordinatorToken}}
Content-Type: application/json

{
  "email": "studentsbims17@grr.la",
  "firstName": "Lionel",
  "middleName": "Victor",
  "lastName": "Messi",
  "suffix": "III",
  "role": "student",
  "password": "Dev2026!"
}


###############################################################

# Coordinator Cannot Update User

###############################################################

### Expected:
### HTTP 403 Forbidden

PATCH {{apiUrl}}/users/{{userId}}
Authorization: Bearer {{coordinatorToken}}
Content-Type: application/json

{
  "firstName": "Unauthorized Update"
}



###############################################################

# Coordinator Cannot Change Role

###############################################################

### Expected:
### HTTP 403 Forbidden

PATCH {{apiUrl}}/users/{{userId}}/role
Authorization: Bearer {{coordinatorToken}}
Content-Type: application/json

{
  "role": "administrator"
}


###############################################################

# Coordinator Cannot Change Status

###############################################################

### Expected:
### HTTP 403 Forbidden

PATCH {{apiUrl}}/users/{{userId}}/status
Authorization: Bearer {{coordinatorToken}}
Content-Type: application/json

{
  "isActive": false
}



