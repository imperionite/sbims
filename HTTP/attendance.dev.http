###############################################################
# STUDENT - OWNERSHIP
###############################################################

### Student Cannot Update Another Student's Attendance

### This test requires a second student's attendance record.
### Replace @attendanceId with an attendance record belonging
### to another student if available.

PATCH {{apiUrl}}/attendance/{{attendanceId}}
Authorization: Bearer {{studentAccessToken}}
Content-Type: application/json

{
  "time_in": "09:00"
}

###

### Expected:
### HTTP 403
###
### You can only update your own attendance.


###############################################################
# ACTIVE INTERNSHIP REQUIREMENT
###############################################################

### Student Cannot Create Attendance for Inactive Internship

### Replace @internshipId with a pending/completed internship
### when performing this test.

POST {{apiUrl}}/attendance
Authorization: Bearer {{studentAccessToken}}
Content-Type: application/json

{
  "internship_id": "{{internshipId}}",
  "attendance_date": "2026-08-13",
  "time_in": "08:00",
  "time_out": "17:00"
}

###

### Expected when internship is not active:
### HTTP 400
###
### Attendance can only be recorded for an active internship.


###############################################################
# COMPLETED ATTENDANCE CANNOT BE VALIDATED TWICE
###############################################################

### Coordinator Cannot Re-validate Already Validated Attendance

PATCH {{apiUrl}}/attendance/{{attendanceId}}/validation
Authorization: Bearer {{coordinatorAccessToken}}
Content-Type: application/json

{
  "validation_status": "validated"
}

###

### Expected:
### HTTP 400
###
### Only pending attendance records can be validated.


###############################################################
# REJECTED ATTENDANCE CANNOT BE VALIDATED AGAIN
###############################################################

### Coordinator Cannot Validate Already Rejected Attendance

PATCH {{apiUrl}}/attendance/{{attendanceId2}}/validation
Authorization: Bearer {{coordinatorAccessToken}}
Content-Type: application/json

{
  "validation_status": "validated"
}

###

### Expected:
### HTTP 400
###
### Only pending attendance records can be validated.
