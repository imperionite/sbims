### Paste a valid student access token here.
@studentAccessToken=eyJhbGciOiJFUzI1NiIsImtpZCI6IjI4OGQ4NzFhLWEzZDItNDA0Ni04Y2QwLTJlZTJhZmM1NmY4ZiIsInR5cCI6IkpXVCJ9..BuOldBKJ1UkaUCgxh11iZDGmiLM6o6sSKvfB4Ii77u7xhTkGab3MsoeCled6PVKgRGr3wj5TSlGIjrLN4tQ34g

### Paste a valid faculty adviser access token here.
@facultyAccessToken=PASTE_FACULTY_ACCESS_TOKEN_HERE


###############################################################
# HEALTH
###############################################################

### Health Check

GET {{apiUrl}}/health

### Expected:
### HTTP 200
### success = true


###############################################################
# ADMINISTRATOR LOGIN
###############################################################

### Administrator Login

POST {{apiUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{admin}}",
  "password": "{{newPassword}}"
}

###

### Expected:
### HTTP 200
### data.accessToken is returned
###
### Copy the accessToken from the response and assign it to:
### @adminAccessToken


###############################################################
# INTERNSHIP COORDINATOR LOGIN
###############################################################

### Internship Coordinator Login

POST {{apiUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{coordinator}}",
  "password": "{{newPassword}}"
}

###

### Expected:
### HTTP 200
### data.accessToken is returned
###
### Copy the accessToken from the response and assign it to:
### @coordinatorAccessToken


###############################################################
# HTE LIST
###############################################################

### FR-04 - Administrator List HTE Profiles

GET {{apiUrl}}/htes
Authorization: Bearer {{adminAccessToken}}

###

### Expected:
### HTTP 200
### success = true
### data = array


###############################################################

### FR-04 - Internship Coordinator List HTE Profiles

GET {{apiUrl}}/htes
Authorization: Bearer {{coordinatorAccessToken}}

###

### Expected:
### HTTP 200
### success = true
### data = array


###############################################################
# HTE CREATE
###############################################################

### FR-04 - Administrator Create HTE

POST {{apiUrl}}/htes
Authorization: Bearer {{adminAccessToken}}
Content-Type: application/json

{
  "companyName": "REST Client Test HTE",
  "address": "Test Address, Bulacan",
  "contactPerson": "Test Contact Person",
  "contactEmail": "contact@example.com",
  "contactNumber": "09171234567"
}

###

### Expected:
### HTTP 201
### success = true
### data.id exists
### data.company_name = "REST Client Test HTE"
### data.address = "Test Address, Bulacan"
### data.contact_person = "Test Contact Person"
### data.contact_email = "contact@example.com"
### data.contact_number = "09171234567"
### data.is_active = true
### data.created_at exists
### data.updated_at exists
###
### Copy the returned data.id and assign it to:
### @hteId


###############################################################

### FR-04 - Internship Coordinator Create HTE

POST {{apiUrl}}/htes
Authorization: Bearer {{coordinatorAccessToken}}
Content-Type: application/json

{
  "companyName": "ABC Industries",
  "address": "Test Address, Taguig City",
  "contactPerson": "Test ABC",
  "contactEmail": "contact@abc-example.com",
  "contactNumber": "09171234567"
}

###

### Expected:
### HTTP 201
### success = true
### HTE profile is created


###############################################################
# HTE RETRIEVE
###############################################################

### FR-04 - Retrieve HTE Profile

GET {{apiUrl}}/htes/{{hteId}}
Authorization: Bearer {{coordinatorAccessToken}}

###

### Expected:
### HTTP 200
### success = true
### data.id = {{hteId}}


###############################################################
# HTE UPDATE
###############################################################

### FR-04 - Update HTE Profile

PATCH {{apiUrl}}/htes/{{hteId}}
Authorization: Bearer {{coordinatorAccessToken}}
Content-Type: application/json

{
  "companyName": "ABC Industries Inc.",
  "contactPerson": "George Smith"
}

###

### Expected:
### HTTP 200
### success = true
### data.id = {{hteId}}
### data.company_name = "Updated REST Client HTE"
### data.contact_person = "Updated Contact Person"
### Existing address remains unchanged


###############################################################

### FR-04 - Partial HTE Update

PATCH {{apiUrl}}/htes/{{hteId}}
Authorization: Bearer {{adminAccessToken}}
Content-Type: application/json

{
  "address": "Updated HTE Address, Bulacan"
}

###

### Expected:
### HTTP 200
### success = true
### data.address = "Updated HTE Address, Bulacan"


###############################################################
# HTE DEACTIVATE
###############################################################

### FR-04 - Deactivate HTE

PATCH {{apiUrl}}/htes/{{hteId}}/status
Authorization: Bearer {{adminAccessToken}}
Content-Type: application/json

{
  "isActive": false
}

###

### Expected:
### HTTP 200
### success = true
### data.is_active = false


###############################################################
# HTE REACTIVATE
###############################################################

### FR-04 - Reactivate HTE

PATCH {{apiUrl}}/htes/{{hteId}}/status
Authorization: Bearer {{adminAccessToken}}
Content-Type: application/json

{
  "isActive": true
}

###

### Expected:
### HTTP 200
### success = true
### data.is_active = true


###############################################################
# VALIDATION - CREATE
###############################################################

### Invalid HTE Data

POST {{apiUrl}}/htes
Authorization: Bearer {{adminAccessToken}}
Content-Type: application/json

{
  "companyName": "",
  "address": "",
  "contactPerson": "",
  "contactEmail": "not-an-email",
  "contactNumber": ""
}

###

### Expected:
### HTTP 400
### Validation error


###############################################################

### Missing Required HTE Fields

POST {{apiUrl}}/htes
Authorization: Bearer {{adminAccessToken}}
Content-Type: application/json

{
  "companyName": "Incomplete HTE"
}

###

### Expected:
### HTTP 400
### Validation error


###############################################################

### Invalid Contact Email

POST {{apiUrl}}/htes
Authorization: Bearer {{adminAccessToken}}
Content-Type: application/json

{
  "companyName": "Invalid Email HTE",
  "address": "Test Address",
  "contactPerson": "Test Person",
  "contactEmail": "invalid-email",
  "contactNumber": "09171234567"
}

###

### Expected:
### HTTP 400


###############################################################

### Empty Contact Number

POST {{apiUrl}}/htes
Authorization: Bearer {{adminAccessToken}}
Content-Type: application/json

{
  "companyName": "Empty Number HTE",
  "address": "Test Address",
  "contactPerson": "Test Person",
  "contactEmail": "test@example.com",
  "contactNumber": ""
}

###

### Expected:
### HTTP 400


###############################################################
# VALIDATION - UPDATE
###############################################################

### Empty HTE Update

PATCH {{apiUrl}}/htes/{{hteId}}
Authorization: Bearer {{adminAccessToken}}
Content-Type: application/json

{}

###

### Expected:
### HTTP 400
### At least one HTE profile field is required.


###############################################################

### Empty Company Name

PATCH {{apiUrl}}/htes/{{hteId}}
Authorization: Bearer {{adminAccessToken}}
Content-Type: application/json

{
  "companyName": ""
}

###

### Expected:
### HTTP 400


###############################################################

### Empty Address

PATCH {{apiUrl}}/htes/{{hteId}}
Authorization: Bearer {{adminAccessToken}}
Content-Type: application/json

{
  "address": ""
}

###

### Expected:
### HTTP 400


###############################################################

### Invalid Update Email

PATCH {{apiUrl}}/htes/{{hteId}}
Authorization: Bearer {{adminAccessToken}}
Content-Type: application/json

{
  "contactEmail": "invalid-email"
}

###

### Expected:
### HTTP 400


###############################################################
# VALIDATION - STATUS
###############################################################

### Invalid HTE Status

PATCH {{apiUrl}}/htes/{{hteId}}/status
Authorization: Bearer {{adminAccessToken}}
Content-Type: application/json

{
  "isActive": "false"
}

###

### Expected:
### HTTP 400
### isActive must be a boolean


###############################################################

### Missing HTE Status

PATCH {{apiUrl}}/htes/{{hteId}}/status
Authorization: Bearer {{adminAccessToken}}
Content-Type: application/json

{}

###

### Expected:
### HTTP 400


###############################################################
# NOT FOUND
###############################################################

### Non-existent HTE

GET {{apiUrl}}/htes/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{adminAccessToken}}

###

### Expected:
### HTTP 404
### HTE profile not found.


###############################################################

### Update Non-existent HTE

PATCH {{apiUrl}}/htes/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{adminAccessToken}}
Content-Type: application/json

{
  "companyName": "Should Not Exist"
}

###

### Expected:
### HTTP 404


###############################################################

### Change Status of Non-existent HTE

PATCH {{apiUrl}}/htes/00000000-0000-0000-0000-000000000000/status
Authorization: Bearer {{adminAccessToken}}
Content-Type: application/json

{
  "isActive": false
}

###

### Expected:
### HTTP 404


###############################################################
# AUTHENTICATION
###############################################################

### Unauthenticated - List HTE Profiles

GET {{apiUrl}}/htes

###

### Expected:
### HTTP 401
### Missing authorization token.


###############################################################

### Invalid Token - List HTE Profiles

GET {{apiUrl}}/htes
Authorization: Bearer invalid-token

###

### Expected:
### HTTP 401
### Invalid authentication token.


###############################################################
# AUTHORIZATION
###############################################################

### Student Cannot List HTE Profiles

GET {{apiUrl}}/htes
Authorization: Bearer {{studentAccessToken}}

###

### Expected:
### HTTP 403
### Insufficient permissions.


###############################################################

### Faculty Adviser Cannot List HTE Profiles

GET {{apiUrl}}/htes
Authorization: Bearer {{facultyAccessToken}}

###

### Expected:
### HTTP 403
### Insufficient permissions.


