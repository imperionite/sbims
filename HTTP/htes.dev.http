###############################################################
# VALIDATION - SUPERVISOR
###############################################################

### Invalid Supervisor UUID
PATCH {{apiUrl}}/htes/{{hteId}}/supervisor
Authorization: Bearer {{coordinatorToken}}
Content-Type: application/json

{
  "supervisorId": "not-a-uuid"
}

### Expected:
### HTTP 400


### Non-existent Supervisor
PATCH {{apiUrl}}/htes/{{hteId}}/supervisor
Authorization: Bearer {{coordinatorToken}}
Content-Type: application/json

{
  "supervisorId": "00000000-0000-0000-0000-000000000000"
}

### Expected:
### HTTP 404
### HTE supervisor profile not found.


### User With Wrong Role As Supervisor
###
### Use a real active user who is NOT an hte_supervisor.
###
PATCH {{apiUrl}}/htes/{{hteId}}/supervisor
Authorization: Bearer {{coordinatorToken}}
Content-Type: application/json

{
  "supervisorId": "{{studentUserId}}"
}

### Expected:
### HTTP 400
### The selected user is not an HTE supervisor.


### Remove HTE Supervisor
PATCH {{apiUrl}}/htes/{{hteId}}/supervisor
Authorization: Bearer {{coordinatorToken}}
Content-Type: application/json

{
  "supervisorId": null
}

### Expected:
### HTTP 200
### data.supervisor_id = null


