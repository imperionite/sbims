### success = true


###############################################################
# ADMINISTRATOR LOGIN
###############################################################

### Administrator Login
POST {{apiUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{admin}}",
  "password": "{{defaultPassword}}"
}

### Expected:
### HTTP 200
### success = true
### data.accessToken is returned
### Copy accessToken to @adminAccessToken


###############################################################
# INTERNSHIP COORDINATOR LOGIN
###############################################################

### Internship Coordinator Login
POST {{apiUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{coordinator}}",
  "password": "{{defaultPassword}}"
}

### Expected:
### HTTP 200
### success = true
### data.accessToken is returned
### Copy accessToken to @coordinatorAccessToken


###############################################################
# HTE SUPERVISOR LOGIN
###############################################################

### HTE Supervisor Login
POST {{apiUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{hte}}",
  "password": "{{defaultPassword}}"
}

### Expected:
### HTTP 200
### success = true
### data.accessToken is returned
### Copy accessToken to @hteSupervisorAccessToken
### Verify returned user.role = "hte_supervisor"


