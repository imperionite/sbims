###############################################################
# SBIMS API
# Authentication Module
#
# Development Test Suite
#
# Order of execution:
# 1. Health Check
# 2. Login
# 3. Change Password (first login)
# 4. Current User
# 5. Logout
# 6. Refresh Token
# 7. Forgot Password
#
# NOTE:
# Reset Password cannot be fully tested from REST Client.
# It requires a Supabase recovery session after clicking
# the password recovery email.
###############################################################

###############################################################
# Variables
###############################################################

@apiUrl=http://localhost:8000/api/v1

### Access token from a successful login
@accessToken=eyJhbGciOiJFUzI1NiIsImtpZCI6IjI4OGQ4NzFhLWEzZDItNDA0Ni04Y2QwLTJlZTJhZmM1NmY4ZiIsInR5cCI6IkpXVCJ9..EHENwWTi2mCwS3D654rGS4aoK5-4CDVslGLtJ_8W4cDMWAAZSq3MXZNKGadL5TDJnmvv9Re14J4cPo2q7vi9LQ
# Seed Users
###############################################################

@admin=adminsbims1@grr.la
@coordinator=coordinatorsbims1@grr.la
@faculty=facultysbims1@grr.la
@student=studentsbims1@grr.la
@hte=htesbims1@grr.la

###############################################################
# Passwords
###############################################################

@defaultPassword=Dev2026!
@newPassword=deV2026!
@renewPassword=deV2026#

###############################################################
# HEALTH
###############################################################

### Health Check
GET {{apiUrl}}/health

###############################################################
# LOGIN
###############################################################

### Login (First Login)
### Expected:
### - Login succeeds
### - mustChangePassword = true
POST {{apiUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{student}}",
  "password": "{{defaultPassword}}"
}

###

### Login (After Password Change)
### Expected:
### - Login succeeds
### - mustChangePassword = false
POST {{apiUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{admin}}",
  "password": "{{newPassword}}"
}

###############################################################
# FIRST LOGIN PASSWORD CHANGE
###############################################################

### Change Password
POST {{apiUrl}}/auth/change-password
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "newPassword": "{{newPassword}}"
}

###############################################################
# CURRENT USER
###############################################################

### Current User
GET {{apiUrl}}/auth/me
Authorization: Bearer {{accessToken}}

###############################################################
# LOGOUT
###############################################################

### Logout
POST {{apiUrl}}/auth/logout
Authorization: Bearer {{accessToken}}

###############################################################
# REFRESH TOKEN
###############################################################

### Refresh Access Token
POST {{apiUrl}}/auth/refresh
Content-Type: application/json

{
  "refreshToken": "YOUR_REFRESH_TOKEN"
}

###############################################################
# FORGOT PASSWORD
###############################################################

### Forgot Password
###
### Expected:
### - HTTP 200
### - Supabase sends recovery email
### - User clicks email manually
###
POST {{apiUrl}}/auth/forgot-password
Content-Type: application/json

{
  "email": "{{admin}}"
}

###

### Forgot Password
### Non-existing email
###
### Expected:
### - HTTP 200
### - Same response message
### - No email sent
###
POST {{apiUrl}}/auth/forgot-password
Content-Type: application/json

{
  "email": "unknown@example.com"
}

###

### Forgot Password
### First-time account
###
### Expected:
### - HTTP 400
### - User must login with temporary password first
###
POST {{apiUrl}}/auth/forgot-password
Content-Type: application/json

{
  "email": "{{student}}"
}

###############################################################
# RESET PASSWORD
###############################################################

### Cannot be tested directly from REST Client.
###
### Flow:
###
### 1. Call Forgot Password.
###
### 2. Open the email.
###
### 3. Click the recovery link.
###
### 4. React receives the recovery session.
###
### 5. React extracts the recovery access token.
###
### 6. React calls:
###
### POST /auth/reset-password
###
### {
### "accessToken": "...",
### "refreshToken": "...",
### "newPassword": "Password123!"
### }
###############################################################
