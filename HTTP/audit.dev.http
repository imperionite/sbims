  "email": "adminsbims1@grr.la",
  "password": "Dev2026!"
}


###############################################################
# AUDIT LOG RETRIEVAL
###############################################################


### Retrieve Default Audit Log Page
###
### Expected:
### - HTTP 200
### - success = true
### - data.items is an array
### - page = 1
### - limit = 20
###
GET {{apiUrl}}/audit-logs
Authorization: Bearer {{adminAccessToken}}
Accept: application/json


### Retrieve Audit Logs with Custom Pagination
###
GET {{apiUrl}}/audit-logs?page=1&limit=10
Authorization: Bearer {{adminAccessToken}}
Accept: application/json


