Authorization: Bearer {{adminAccessToken}}
Accept: application/json


###############################################################
# DATE RANGE FILTERING
###############################################################


### Filter by Date Range
###
GET {{apiUrl}}/audit-logs?from=2026-09-01T00:00:00.000Z&to=2026-09-11T23:59:59.999Z
Authorization: Bearer {{adminAccessToken}}
Accept: application/json


### Filter by Date Range with Action
###
GET {{apiUrl}}/audit-logs?action=LOGIN&from=2026-09-01T00:00:00.000Z&to=2026-09-11T23:59:59.999Z
Authorization: Bearer {{adminAccessToken}}
Accept: application/json


###############################################################
# PAGINATION
###############################################################


### Page 1 with Limit 2
###
GET {{apiUrl}}/audit-logs?page=1&limit=2
Authorization: Bearer {{adminAccessToken}}
Accept: application/json


### Page 2 with Limit 2
###
GET {{apiUrl}}/audit-logs?page=2&limit=2
Authorization: Bearer {{adminAccessToken}}
Accept: application/json


### Maximum Page Size
###
GET {{apiUrl}}/audit-logs?page=1&limit=100
Authorization: Bearer {{adminAccessToken}}
Accept: application/json


### Combined Filters and Pagination
###
GET {{apiUrl}}/audit-logs?action=LOGIN&resourceType=AUTH&page=1&limit=10
Authorization: Bearer {{adminAccessToken}}
Accept: application/json


###############################################################
# VALIDATION TESTS
###############################################################


### Invalid Audit Action
###
### Expected:
### - HTTP 400
###
GET {{apiUrl}}/audit-logs?action=INVALID_ACTION
Authorization: Bearer {{adminAccessToken}}
Accept: application/json


### Invalid User ID
###
### Expected:
### - HTTP 400
###
GET {{apiUrl}}/audit-logs?userId=not-a-uuid
Authorization: Bearer {{adminAccessToken}}
Accept: application/json


### Invalid Page Number
###
### Expected:
### - HTTP 400
###
GET {{apiUrl}}/audit-logs?page=0
Authorization: Bearer {{adminAccessToken}}
Accept: application/json


### Negative Page Number
###
### Expected:
### - HTTP 400
###
GET {{apiUrl}}/audit-logs?page=-1
Authorization: Bearer {{adminAccessToken}}
Accept: application/json


### Invalid Limit
###
### Expected:
### - HTTP 400
###
GET {{apiUrl}}/audit-logs?limit=0
Authorization: Bearer {{adminAccessToken}}
Accept: application/json


### Limit Above Maximum
###
### Expected:
### - HTTP 400
###
GET {{apiUrl}}/audit-logs?limit=101
Authorization: Bearer {{adminAccessToken}}
Accept: application/json


### Invalid From Date
###
### Expected:
### - HTTP 400
###
GET {{apiUrl}}/audit-logs?from=not-a-date
Authorization: Bearer {{adminAccessToken}}
Accept: application/json


### Invalid To Date
###
### Expected:
### - HTTP 400
###
GET {{apiUrl}}/audit-logs?to=not-a-date
Authorization: Bearer {{adminAccessToken}}
Accept: application/json


### Reversed Date Range
###
### Expected:
### - HTTP 400
###
GET {{apiUrl}}/audit-logs?from=2026-09-11T00:00:00.000Z&to=2026-09-01T00:00:00.000Z
Authorization: Bearer {{adminAccessToken}}
Accept: application/json


###############################################################
# AUTHENTICATION AND AUTHORIZATION
###############################################################


### Unauthenticated Request
###
### Expected:
### - HTTP 401
###
GET {{apiUrl}}/audit-logs
Accept: application/json


### Invalid Access Token
###
### Expected:
### - HTTP 401
###
GET {{apiUrl}}/audit-logs
Authorization: Bearer invalid-token
Accept: application/json


### Student Access
###
### Expected:
### - HTTP 403
###
GET {{apiUrl}}/audit-logs
Authorization: Bearer {{studentToken}}
Accept: application/json


### Administrator Access
###
### Expected:
### - HTTP 200
###
GET {{apiUrl}}/audit-logs
Authorization: Bearer {{adminAccessToken}}
Accept: application/json


###############################################################
# READ-ONLY API TESTS
###############################################################


### Create Audit Log Through Public API
###
### Expected:
### - HTTP 404
###
POST {{apiUrl}}/audit-logs
Authorization: Bearer {{adminAccessToken}}
Content-Type: application/json
Accept: application/json

{
  "action": "CREATE_INTERNSHIP",
  "resourceType": "internship",
  "resourceId": "{{resourceId}}",
  "details": {
    "test": true
  }
}


### Modify Audit Log Through Public API
###
### Expected:
### - HTTP 404
###
PATCH {{apiUrl}}/audit-logs/{{resourceId}}
Authorization: Bearer {{adminAccessToken}}
Content-Type: application/json
Accept: application/json

{
  "action": "DELETE_DOCUMENT"
}


### Delete Audit Log Through Public API
###
### Expected:
### - HTTP 404
###
DELETE {{apiUrl}}/audit-logs/{{resourceId}}
Authorization: Bearer {{adminAccessToken}}
Accept: application/json


