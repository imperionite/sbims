Accept: application/json


###############################################################
# ADMINISTRATOR LOGIN
###############################################################


### Administrator Login
###
### Expected:
### - HTTP 200
### - success = true
### - data.accessToken is returned
### - data.user.role = administrator
###
POST {{apiUrl}}/auth/login
Content-Type: application/json
Accept: application/json

