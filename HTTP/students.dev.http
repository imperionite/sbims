@newPassword=deV2026!

@adminUserId=ADD_HERE
@studentUserId=70100cc3-d070-42e0-9b62-8b465517948e
@facultyUserId=f07b44cd-ddbb-435a-bf53-7e7f3c8874d5
@coordinatorUserId=041388a4-4154-4677-b441-1e106216317b

###############################################################

# Tokens

###############################################################

# Replace after login

@adminToken=PASTE_ADMIN_ACCESS_TOKEN

@studentToken=eyJhbGciOiJFUzI1NiIsImtpZCI6IjI4OGQ4NzFhLWEzZDItNDA0Ni04Y2QwLTJlZTJhZmM1NmY4ZiIsInR5cCI6IkpXVCJ9..VtmYmC3CHnbTUvIBvCAodymw4hrd0o4Iq5EEy7629C8DmIcWBG0bAhQDaAISlXl4w3Lz8vKBNFnC1oskLGLyhQ

@facultyToken=eyJhbGciOiJFUzI1NiIsImtpZCI6IjI4OGQ4NzFhLWEzZDItNDA0Ni04Y2QwLTJlZTJhZmM1NmY4ZiIsInR5cCI6IkpXVCJ9..SCUruMD4V49rKAXzm5eIQtUv2q192VcxqvTH5c7Sc-S_kLdpwWtu9qR6tGaByB7VPMcQLwoFY-6XW1tiwZuM3w

@coordinatorToken=eyJhbGciOiJFUzI1NiIsImtpZCI6IjI4OGQ4NzFhLWEzZDItNDA0Ni04Y2QwLTJlZTJhZmM1NmY4ZiIsInR5cCI6IkpXVCJ9..m8mcoSwW-C7330St9b4bAzuFE75005L2x-eQQL9SokHePSOiu0_ij4erjDUZbGv7QEOTGbL2rUD7xGjnboJ6oA

###############################################################
### Student Info
@studentNumber=FR03-MANUAL-001


###############################################################

###############################################################

# LOGIN ADMINISTRATOR

###############################################################

### Login Administrator

### Expected:

### - HTTP 200

### - success = true

### - accessToken returned

### - user.id returned

POST {{apiUrl}}/auth/login
Content-Type: application/json

{
"email": "{{coordinator}}",
"password": "{{newPassword}}"
}

###############################################################

# LOGIN STUDENT

###############################################################

### Login Student

### Expected:

### - HTTP 200

### - success = true

### - accessToken returned

### - user.id returned

POST {{apiUrl}}/auth/login
Content-Type: application/json

{
"email": "{{student}}",
"password": "{{newPassword}}"
}

####
POST {{apiUrl}}/auth/login
Content-Type: application/json

{
"email": "{{faculty}}",
"password": "{{newPassword}}"
}

###############################################################

# FR-03 CREATE STUDENT PROFILE

###############################################################

### Coordinator Creates Student Profile

### Permission:

### - administrator

### Expected:

### - HTTP 201

### - success = true

### - Student profile created

### - id matches student user ID

### - internship_status = pending

POST {{apiUrl}}/students
Authorization: Bearer {{coordinatorToken}}
Content-Type: application/json

{
"userId": "{{studentUserId}}",
"studentNumber": "{{studentNumber}}",
"program": "BS Information Technology",
"yearLevel": 4,
"section": "A",
"contactNumber": "09123456789",
"address": "Bulacan, Philippines",
"emergencyContactName": "Juan Cruz",
"emergencyContactNumber": "09987654321"
}

###############################################################

# FR-03 DUPLICATE STUDENT PROFILE

###############################################################

### Administrator Attempts Duplicate Profile

### Run after successful profile creation.

### Expected:

### - HTTP 409 Conflict

### - Existing student profile is not duplicated

POST {{apiUrl}}/students
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
"userId": "{{studentUserId}}",
"studentNumber": "FR03-MANUAL-002",
"program": "BS Information Technology",
"yearLevel": 4,
"section": "A",
"contactNumber": "09123456789",
"address": "Bulacan, Philippines",
"emergencyContactName": "Juan Cruz",
"emergencyContactNumber": "09987654321"
}

###############################################################

# FR-03 RETRIEVE STUDENT PROFILE

###############################################################

### Administrator Retrieves Student Profile

### Expected:

### - HTTP 200

### - success = true

### - Profile returned

### - id = student user ID

GET {{apiUrl}}/students/{{studentUserId}}
Authorization: Bearer {{coordinatorToken}}

###############################################################

# FR-03 STUDENT RETRIEVES OWN PROFILE

###############################################################

### Student Self-Service

### Expected:

### - HTTP 200

### - success = true

### - Student's own profile returned

GET {{apiUrl}}/students/me
Authorization: Bearer {{studentToken}}

###############################################################

# FR-03 STUDENT UPDATE OWN INFORMATION

###############################################################

### Student Updates Editable Information

### Expected:

### - HTTP 200

### - contact_number updated

### - address updated

PATCH {{apiUrl}}/students/me
Authorization: Bearer {{studentToken}}
Content-Type: application/json

{
"contactNumber": "09999999999",
"address": "Updated Student Address"
}

###############################################################

# FR-03 VERIFY STUDENT UPDATE

###############################################################

### Verify Editable Information

### Expected:

### - HTTP 200

### - Updated contact number returned

### - Updated address returned

GET {{apiUrl}}/students/me
Authorization: Bearer {{studentToken}}

###############################################################

# FR-03 PROTECTED FIELD TEST

###############################################################

### Student Attempts To Modify Protected Fields

### Protected fields:

### - studentNumber

### - program

### - yearLevel

### - internshipStatus

### Expected:

### - HTTP 400 or 403

### - Protected fields remain unchanged

PATCH {{apiUrl}}/students/me
Authorization: Bearer {{studentToken}}
Content-Type: application/json

{
"studentNumber": "HACKED-STUDENT-NUMBER",
"program": "Hacked Program",
"yearLevel": 1,
"internshipStatus": "completed"
}

###############################################################

# VERIFY PROTECTED FIELDS

###############################################################

### Expected:

### - HTTP 200

### - Original studentNumber remains unchanged

### - Original program remains unchanged

### - Original yearLevel remains unchanged

GET {{apiUrl}}/students/me
Authorization: Bearer {{studentToken}}

###############################################################

# FR-03 STUDENT CANNOT RETRIEVE PROFILE THROUGH /:id

###############################################################

### Student Attempts Staff Profile Endpoint

### Expected:

### - HTTP 403 Forbidden

GET {{apiUrl}}/students/{{studentUserId}}
Authorization: Bearer {{studentToken}}

###############################################################

# FR-03 FACULTY AUTHORIZATION TEST

###############################################################

### Faculty Adviser Attempts To Create Student Profile

### Note:

### Use a user ID that does not already have a student profile

### when testing authorization so that 409 does not mask 403.

### Expected:

### - HTTP 403 Forbidden

POST {{apiUrl}}/students
Authorization: Bearer {{facultyToken}}
Content-Type: application/json

{
"userId": "{{adminUserId}}",
"studentNumber": "FR03-FACULTY-001",
"program": "BS Information Technology",
"yearLevel": 4,
"section": "A",
"contactNumber": "09123456789",
"address": "Bulacan, Philippines",
"emergencyContactName": "Juan Cruz",
"emergencyContactNumber": "09987654321"
}

###############################################################

# FR-03 STUDENT CANNOT CREATE PROFILE

###############################################################

### Student Attempts To Create Own Profile

### Expected:

### - HTTP 403 Forbidden

### - Authorization checked before duplicate handling

POST {{apiUrl}}/students
Authorization: Bearer {{studentToken}}
Content-Type: application/json

{
"userId": "{{studentUserId}}",
"studentNumber": "FR03-STUDENT-001",
"program": "BS Information Technology",
"yearLevel": 4,
"section": "A",
"contactNumber": "09123456789",
"address": "Bulacan, Philippines",
"emergencyContactName": "Juan Cruz",
"emergencyContactNumber": "09987654321"
}

###############################################################

# FR-03 UNAUTHENTICATED ACCESS

###############################################################

### Missing Token - Student Profile

### Expected:

### - HTTP 401 Unauthorized

GET {{apiUrl}}/students/me

###############################################################

# FR-03 UNAUTHENTICATED ACCESS BY ID

###############################################################

### Missing Token - Student Profile By ID

### Expected:

### - HTTP 401 Unauthorized

GET {{apiUrl}}/students/{{studentUserId}}

###############################################################

# FR-03 VERIFY FINAL STUDENT PROFILE

###############################################################

### Final Student Self-Service Verification

### Expected:

### - HTTP 200

### - Profile exists

### - id matches authenticated student

### - Editable information is preserved

GET {{apiUrl}}/students/me
Authorization: Bearer {{studentToken}}


###############################################################

# GET ALL STUDENTS

###############################################################
GET {{apiUrl}}/students
Authorization: Bearer {{coordinatorToken}}