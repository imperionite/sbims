{
  "$schema": "https://www.unpkg.com/wrangler/config-schema.json",

  "name": "sbims",

  "main": "dist/worker.js",

  "compatibility_date": "2026-08-11",

  "compatibility_flags": ["nodejs_compat"],

  "build": {
    "command": "deno task build:worker"
  },

  "observability": {
    "enabled": true
  }
}
