{
  "nodeModulesDir": "auto",
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/testing": "jsr:@std/testing@^1.0.21",
    "@upstash/redis": "npm:@upstash/redis@^1.40.0",
    "hono": "npm:hono@^4.13.14",
    "@hono/zod-validator": "npm:@hono/zod-validator@^0.9.1",
    "zod": "npm:zod@^4.6.7",
    "@supabase/supabase-js": "npm:@supabase/supabase-js@^2.118.0",
    "@std/testing/mock": "jsr:@std/testing@^1.0.21/mock",
    "hono-rate-limiter": "npm:hono-rate-limiter@^0.5.4"
  },
  "tasks": {
    "dev": "deno serve --watch --env-file=.env --allow-env --allow-read --allow-net src/main.ts",
    "seed:users": "deno run --env-file=.env --allow-env --allow-net --allow-read supabase/seed/users.ts",
    "seed:students": "deno run --env-file=.env --allow-env --allow-net --allow-read supabase/seed/students.ts",
    "seed:htes": "deno run --env-file=.env --allow-env --allow-net --allow-read supabase/seed/htes.ts",
    "seed:internships": "deno run --env-file=.env --allow-env --allow-net --allow-read supabase/seed/internships.ts",
    "seed:attendance": "deno run --env-file=.env --allow-env --allow-net --allow-read supabase/seed/attendance.ts",
    "seed:evaluations": "deno run --env-file=.env --allow-env --allow-net --allow-read supabase/seed/evaluations.ts",
    "seed:documents": "deno run --env-file=.env --allow-env --allow-net --allow-read supabase/seed/documents.ts",
    "seed:reports": "deno run --env-file=.env --allow-env --allow-net --allow-read supabase/seed/reports.ts",
    "seed:audit": "deno run --env-file=.env --allow-env --allow-net --allow-read supabase/seed/audit.ts",
    "fmt": "deno fmt",
    "lint": "deno lint",
    "verify": "deno fmt --check && deno lint && deno task check",
    "refresh": "deno cache --reload src/main.ts",
    "lock:update": "deno install --frozen=false",
    "check": "deno check src supabase tests",
    "test": "deno task test:unit && deno task test:integration",
    "test:coverage": "deno test --env-file=.env.test tests --coverage=coverage --allow-env --allow-net --allow-read && deno coverage coverage",
    "test:unit": "deno test --env-file=.env.test tests/unit --allow-read --allow-env --allow-net",
    "test:unit:htes": "deno test --env-file=.env.test tests/unit/htes/htes.service.test.ts --allow-read --allow-env --allow-net",
    "test:unit:auth": "deno test --env-file=.env.test tests/unit/auth/auth.service.test.ts --allow-read --allow-env --allow-net",
    "test:unit:users": "deno test --env-file=.env.test tests/unit/users/role.middleware.test.ts --allow-read --allow-env --allow-net",
    "test:unit:students": "deno test --env-file=.env.test tests/unit/students/students.service.test.ts --allow-read --allow-env --allow-net",
    "test:unit:internships": "deno test --env-file=.env.test tests/unit/internships/internships.test.ts --allow-read --allow-env --allow-net",
    "test:unit:attendance": "deno test --env-file=.env.test tests/unit/attendance/attendance.test.ts --allow-read --allow-env --allow-net",
    "test:unit:evaluations": "deno test --env-file=.env.test tests/unit/evaluations/evaluations.test.ts --allow-all",
    "test:unit:documents": "deno test --env-file=.env.test tests/unit/documents/documents.service.test.ts --allow-read --allow-env --allow-net",
    "test:unit:reports": "deno test --env-file=.env.test tests/unit/reports/reports.test.ts --allow-read --allow-env --allow-net",
    "test:unit:audit": "deno test --env-file=.env.test tests/unit/audit/audit.test.ts --allow-read --allow-env --allow-net",
    "test:unit:infrastructure:rate-limit": "deno test --env-file=.env.test tests/unit/infrastructure/noop-rate-limit.store.test.ts --allow-read --allow-env --allow-net",
    "test:unit:middleware:rate-limit": "deno test --env-file=.env.test tests/unit/middleware/rate-limit.middleware.test.ts --allow-read --allow-env --allow-net",
    "test:smoke:upstash": "deno test --env-file=.env.test tests/smoke/upstash-redis.smoke.test.ts --allow-read --allow-env --allow-net",
    "test:integration": "deno test --env-file=.env.test tests/integration --allow-read --allow-env --allow-net",
    "test:integration:auth": "deno test --env-file=.env.test tests/integration/auth.integration.test.ts --allow-read --allow-env --allow-net",
    "test:integration:users": "deno test --env-file=.env.test tests/integration/users.integration.test.ts --allow-read --allow-env --allow-net",
    "test:integration:students": "deno test --env-file=.env.test tests/integration/students.integration.test.ts --allow-read --allow-env --allow-net",
    "test:integration:htes": "deno test --env-file=.env.test tests/integration/htes.integration.test.ts --allow-read --allow-env --allow-net",
    "test:integration:internships": "deno test --env-file=.env.test tests/integration/internships.integration.test.ts --allow-read --allow-env --allow-net",
    "test:integration:attendance": "deno test --env-file=.env.test tests/integration/attendance.integration.test.ts --allow-read --allow-env --allow-net",
    "test:integration:evaluations": "deno test --env-file=.env.test tests/integration/evaluations.integration.test.ts --allow-all",
    "test:integration:documents": "deno test --env-file=.env.test tests/integration/documents.integration.test.ts --allow-read --allow-env --allow-net",
    "test:integration:reports": "deno test --env-file=.env.test tests/integration/reports.integration.test.ts --allow-read --allow-env --allow-net",
    "test:integration:audit": "deno test --env-file=.env.test tests/integration/audit.integration.test.ts --allow-all",
    "test:integration:authorization": "deno test --env-file=.env.test tests/integration/authorization-rbac.integration.test.ts --allow-read --allow-env --allow-net",
    "cov:auth": "deno test --env-file=.env.test --coverage=coverage/auth tests/unit/auth tests/integration/auth.integration.test.ts --allow-read --allow-env --allow-net && deno coverage coverage/auth --include='src/modules/auth/'",
    "cov:users": "deno test --env-file=.env.test --coverage=coverage/users tests/unit/users tests/integration/users.integration.test.ts --allow-read --allow-env --allow-net && deno coverage coverage/users --include='src/modules/users/'",
    "cov:students": "deno test --env-file=.env.test --coverage=coverage/students tests/unit/students tests/integration/students.integration.test.ts --allow-read --allow-env --allow-net && deno coverage coverage/students --include='src/modules/students/'",
    "cov:htes": "deno test --env-file=.env.test --coverage=coverage/htes tests/unit/htes tests/integration/htes.integration.test.ts --allow-read --allow-env --allow-net && deno coverage coverage/htes --include='src/modules/htes/'",
    "cov:internships": "deno test --env-file=.env.test --coverage=coverage/internships tests/unit/internships tests/integration/internships.integration.test.ts --allow-read --allow-env --allow-net && deno coverage coverage/internships --include='src/modules/internships/'",
    "cov:attendance": "deno test --env-file=.env.test --coverage=coverage/attendance tests/unit/attendance tests/integration/attendance.integration.test.ts --allow-read --allow-env --allow-net && deno coverage coverage/attendance --include='src/modules/attendance/'",
    "cov:evaluations": "deno test --env-file=.env.test --coverage=coverage/evaluations tests/unit/evaluations tests/integration/evaluations.integration.test.ts --allow-all && deno coverage coverage/evaluations --include='src/modules/evaluations/'",
    "cov:documents": "deno test --env-file=.env.test --coverage=coverage/documents tests/unit/documents tests/integration/documents.integration.test.ts --allow-read --allow-env --allow-net && deno coverage coverage/documents --include='src/modules/documents/'",
    "cov:reports": "deno test --env-file=.env.test --coverage=coverage/reports tests/unit/reports tests/integration/reports.integration.test.ts --allow-read --allow-env --allow-net && deno coverage coverage/reports --include='.*src/modules/reports/.*'",
    "cov:audit": "deno test --env-file=.env.test --coverage=coverage/audit tests/unit/audit tests/integration/audit.integration.test.ts --allow-all && deno coverage coverage/audit --include='src/modules/audit/'",
    "cov:authorization": "deno test --env-file=.env.test --coverage=coverage/authorization tests/integration/authorization-rbac.integration.test.ts tests/integration/users.integration.test.ts tests/integration/students.integration.test.ts tests/integration/htes.integration.test.ts tests/integration/internships.integration.test.ts tests/integration/evaluations.integration.test.ts tests/integration/documents.integration.test.ts tests/integration/reports.integration.test.ts tests/integration/audit.integration.test.ts --allow-all && deno coverage coverage/authorization --include=\"src/modules/\"",
    "security:setup": "deno run --env-file=.env.test --allow-env --allow-net --allow-read .github/scripts/setup-security-test-users.ts",
    "bootstrap-admin": "deno run --env-file=.env.prod --allow-env --allow-net --allow-read supabase/bootstrap/create-admin.ts"
  },
  "fmt": {
    "lineWidth": 100
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ]
    }
  },
  "exclude": [
    "k6/",
    "worker-configuration.d.ts"
  ],
  "compilerOptions": {
    "strict": true
  },
  "deploy": {
    "runtime": {
      "mode": "dynamic",
      "entrypoint": "src/main.ts"
    },
    "org": "imperionite",
    "app": "sbims"
  },
  "allowScripts": [
    "npm:workerd"
  ]
}
